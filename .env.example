# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — found in Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public base URL used in published links (defaults to the request host)
NEXT_PUBLIC_APP_URL=
